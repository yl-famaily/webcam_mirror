<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store 제출용 MSIX 매니페스트.

  Identity 의 세 값은 Partner Center 의 "제품 ID 보기" 에 있는 것과 **글자
  하나까지 같아야 한다.** 다르면 업로드 단계에서 거부된다.

  Version 의 네 번째 자리(수정 버전)는 Store 가 자기 몫으로 예약해 두었으므로
  반드시 0 이어야 한다. 올릴 때마다 앞의 세 자리를 올린다.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="develckm.WebcamMirror"
    Publisher="CN=38D735B8-ED82-46F3-AC30-0288943D6672"
    Version="0.1.10.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Webcam Mirror</DisplayName>
    <PublisherDisplayName>develckm</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <!--
    스토어가 "지원 언어"로 표시하는 목록이다. 첫 항목이 기본값이라, 선언은
    했지만 해당 언어 리소스가 없는 경우 여기로 되돌아간다.
  -->
  <Resources>
    <Resource Language="ko-KR" />
    <Resource Language="en-US" />
    <Resource Language="ja-JP" />
    <Resource Language="zh-Hans" />
  </Resources>

  <Applications>
    <Application
      Id="WebcamMirror"
      Executable="WebcamMirror.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Webcam Mirror"
        Description="바탕화면 위에 작은 웹캠 창을 띄우는 오버레이 앱. 크기·모양·투명도를 바꾸고 배경을 지울 수 있습니다."
        BackgroundColor="#2563EB"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- 데스크톱 브리지(Win32 전체 신뢰) 앱은 이게 있어야 한다. -->
    <rescap:Capability Name="runFullTrust" />
    <!-- 웹캠 앱이므로 필수. 없으면 카메라가 열리지 않는다. -->
    <DeviceCapability Name="webcam" />
  </Capabilities>
</Package>
